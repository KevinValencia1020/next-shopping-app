// ============================================================
// PRISMA SCHEMA — next-shopping
// ============================================================
// Version reconciliada con las historias de usuario, requisitos
// y decisiones de alcance definidas en /docs.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING     // Pendiente
  CONFIRMED   // Confirmado
  SHIPPED     // Enviado
  DELIVERED   // Entregado
  // Nota: no incluye CANCELLED — no se definio flujo de cancelacion
  // (HU-18 solo contempla estos 4 estados en secuencia).
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ============================================================
// TABLA: User
// ------------------------------------------------------------
// Representa clientes y administradores (HU-01, HU-15).
// ============================================================

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // Hash con bcrypt (RNF-04). Nunca texto plano.

  firstName String
  lastName  String
  role      Role   @default(CUSTOMER)
  phone     String?

  // -- Seguridad: bloqueo por intentos fallidos (RNF-05) --
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  cartItems     CartItem[]
  orders        Order[]
  favorites     Favorite[]
  searchHistory SearchHistory[]

  @@map("users")
}

// ============================================================
// TABLA: Address
// ------------------------------------------------------------
// Un usuario puede tener varias direcciones (HU-04).
// ============================================================

model Address {
  id        String  @id @default(uuid())
  userId    String
  label     String  // Ej: "Casa", "Trabajo"
  street    String
  city      String
  state     String
  country   String  @default("Colombia")
  isDefault Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// ============================================================
// TABLA: Category
// ------------------------------------------------------------
// Categorias PLANAS, sin jerarquia/subcategorias (decision de
// alcance — ver 07-base-de-datos.md).
// ============================================================

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)

  products  Product[]
  discounts Discount[]

  @@map("categories")
}

// ============================================================
// TABLA: Product
// ------------------------------------------------------------
// HU-16 (creacion), HU-06/07 (busqueda y detalle).
// ============================================================

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String
  price       Decimal @db.Decimal(10, 2) // Decimal, nunca Float, para dinero

  stock    Int     @default(0)
  isActive Boolean @default(true)

  brand      String?
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Caracteristicas dinamicas del formulario admin (HU-16)
  specs Json @default("{}")

  // -- Campos ya existentes en la tabla real, conservados       --
  // -- para no perder datos aunque no los use ninguna historia  --
  // -- de usuario actualmente:                                  --
  isFeatured Boolean @default(false)
  viewCount  Int     @default(0)

  // Contador de ventas: usado como criterio de "Destacados"
  // en el feed por defecto para usuarios sin sesion (RF-17)
  salesCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images        ProductImage[]
  discounts     Discount[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  favorites     Favorite[]
  searchHistory SearchHistory[]

  @@map("products")
}

// ============================================================
// TABLA: ProductImage
// ------------------------------------------------------------
// Imagenes separadas del producto (evita array en una columna).
// position = 0 es la imagen principal (ver wireframe admin).
// ============================================================

model ProductImage {
  id        String @id @default(uuid())
  productId String
  url       String // URL de Cloudinary
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ============================================================
// TABLA: Discount (Oferta)
// ------------------------------------------------------------
// HU-17. Aplica a UN producto especifico O a UNA categoria,
// nunca ambos (se valida en el backend/service, no aqui).
// Incluye fechas de vigencia (RF-21, RF-22).
// ============================================================

model Discount {
  id    String       @id @default(uuid())
  type  DiscountType
  value Decimal      @db.Decimal(10, 2) // % o monto fijo segun 'type'

  startDate DateTime
  endDate   DateTime

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("discounts")
}

// ============================================================
// TABLA: Favorite
// ------------------------------------------------------------
// HU-08 (marcar favorito) y HU-14 (seccion en el home).
// ============================================================

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // Un usuario no puede duplicar el mismo favorito
  @@map("favorites")
}

// ============================================================
// TABLA: SearchHistory (busquedas_recientes)
// ------------------------------------------------------------
// Fuente UNICA de verdad para el feed personalizado (HU-13).
// El "peso por categoria" se calcula con una consulta
// (COUNT agrupado por categoryId), sin tabla aparte de pesos.
// ============================================================

model SearchHistory {
  id         String   @id @default(uuid())
  userId     String
  term       String   // Texto buscado por el usuario
  categoryId String?  // Categoria inferida del resultado buscado (si aplica)
  productId  String?  // Producto visitado desde la busqueda (si aplica)
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("search_history")
}

// ============================================================
// TABLA: CartItem
// ------------------------------------------------------------
// Carrito persistente (decision confirmada). No existe una
// tabla "Cart" intermedia: el item se asocia directo al
// usuario, lo que ya garantiza persistencia entre sesiones.
// ============================================================

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // Si ya esta en el carrito, se aumenta cantidad
  @@map("cart_items")
}

// ============================================================
// TABLA: Order (Pedido)
// ------------------------------------------------------------
// HU-11/HU-12/HU-18. Guarda subtotal/total historicos —
// un cambio de precio futuro no altera pedidos ya realizados.
// ============================================================

model Order {
  id        String      @id @default(uuid())
  userId    String
  addressId String
  status    OrderStatus @default(PENDING)

  subtotal Decimal @db.Decimal(10, 2)
  shipping Decimal @db.Decimal(10, 2) @default(0)
  total    Decimal @db.Decimal(10, 2)

  // Simulacion simple de pago (sin pasarela real ni tokens):
  paymentMethod String // Ej: "tarjeta", "pse" — solo el tipo elegido
  paymentStatus String @default("approved") // "approved" | "failed" (simulado)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  address Address     @relation(fields: [addressId], references: [id])
  items   OrderItem[]

  @@map("orders")
}

// ============================================================
// TABLA: OrderItem
// ------------------------------------------------------------
// priceAtPurchase es CRITICO: precio pagado, no el actual.
// ============================================================

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  productId       String
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}
